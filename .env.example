# ============================================================
# PaperBento 환경변수
# ============================================================
# 로컬: 이 파일을 .env.local 로 복사하고 값을 채우세요.
# 스택으로 띄울 때: 설치 마법사가 config/paperbento.env 에 적으므로
#                  이 파일을 손댈 필요가 없습니다.

# --- DB / 파일 저장 ---
DATABASE_PATH=./data/paperbento.db
# 올린 PDF 원본과 표지 썸네일이 저장되는 디렉터리
UPLOAD_DIR=./data/uploads
# 업로드 1개당 최대 크기 (MB). 조각 전송이라 메모리와 무관하게 키울 수 있습니다.
# 논문 PDF 는 대개 몇 MB 지만 스캔한 학위논문은 수백 MB 가 되기도 합니다.
MAX_UPLOAD_MB=5120

# --- 자매 앱 (선택) ---
# 헤더에서 메일함·메모함으로 건너가는 버튼의 주소입니다.
# 비우면 지금 접속한 호스트의 3000 / 3001 포트로 자동 유추합니다
# (LAN / Tailscale / MagicDNS 중 무엇으로 들어왔든 그대로 따라감).
# 한 도메인을 경로로 나눠 쓰는 배포라면 그 유추가 맞지 않으니 전체 주소를 적으세요.
#   MAILBENTO_URL=https://bento.example.com/mail
#   MEMOBENTO_URL=https://bento.example.com/memo
MAILBENTO_URL=
MEMOBENTO_URL=

# --- 인증 (선택) ---
# 둘 다 비워두면 인증 비활성 (앱 그대로 공개). Tailscale 만으로 보안 충분하다면 비워둬도 OK.
#
# AUTH_PASSWORD: plaintext 또는 bcrypt 해시 ($2a$ / $2b$ 시작) 둘 다 자동 감지.
#   bcrypt 추천 — plaintext 는 누군가 .env.local 을 보면 그대로 노출됨.
AUTH_PASSWORD=
# AUTH_SECRET: 세션 쿠키 암호화 키 (32바이트 base64). 절대 외부 노출 금지.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- 에이전트 채팅 (선택) ---
# BentoAgent 의 HTTP 입구. 둘 다 채워야 우상단 "대화" 버튼이 뜹니다.
# 브라우저가 직접 부르지 않고 이 앱이 서버에서 프록시하므로 토큰은 노출되지 않습니다.
AGENT_URL=http://127.0.0.1:4000
AGENT_TOKEN=

# --- 하위 경로 배포 (선택, 빌드 시점) ---
# 한 도메인을 경로로 나눠 쓸 때만. `.env.local` 이 아니라 이미지를 만들 때
# 넘겨야 합니다 — Next 가 이 값을 산출물 곳곳에 미리 심어서 런타임에는
# 바꿀 수 없습니다. (스택에서는 옆의 .env 에 PAPERBENTO_BASE_PATH 로 적습니다.)
#   docker build --build-arg BASE_PATH=/paper .
# BASE_PATH=/paper
